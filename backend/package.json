    "socket.io": "^4.7.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.1",
    "supertest": "^7.1.4"
  }
