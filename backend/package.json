{
  "name": "fitness-connect-backend",
  "version": "1.0.0",
  "description": "Backend for Fitness Connect Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate":"npx sequelize-cli db:migrate",
